# =====================================================================
# Comparative RAG POC Configuration Template (.env.example)
# =====================================================================

# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Method 2 (Legacy Flash Markdown Pipeline) Models
# Options:
#   - gemini-3.5-flash-lite : ~1.8s/page, $0.0375/1M tokens (fastest & cheapest)
#   - gemini-3.8-flash      : ~3.5s/page, $0.075/1M tokens (flagship vision)
#   - gemini-2.5-flash      : ~4.0s/page, $0.075/1M tokens
FLASH_VISION_MODEL=gemini-3.5-flash-lite

# Query Answer Generator Model
# Options: gemini-3.8-flash, gemini-3.5-flash-lite
FLASH_GENERATOR_MODEL=gemini-3.8-flash

# Local Vector Embedding Model
FLASH_EMBEDDING_MODEL=text-embedding-004

# Method 1 (BigQuery Native Pipeline) Models
BQ_EMBEDDING_MODEL=text-embedding-005
BQ_GENERATOR_MODEL=gemini-3.8-flash
DOCUMENT_AI_PROCESSOR_ID=your-docai-processor-id

# Method 4 (Direct Long-Context Gemini Flash Zero-Embedding Pipeline)
DIRECT_GEMINI_MODEL=gemini-3.8-flash
GCS_CORPUS_BUCKET=your-gcs-bucket-name



